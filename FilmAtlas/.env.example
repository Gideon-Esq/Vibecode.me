# TMDB API Configuration
# Server-side only — never prefix this with NEXT_PUBLIC_, or it gets bundled into client JS.
TMDB_API_KEY=
NEXT_PUBLIC_TMDB_API_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
NEXT_PUBLIC_TMDB_AUTH_BASE_URL=https://www.themoviedb.org

# Neon Postgres — Connection Details in the Neon console (use the pooled URL)
DATABASE_URL=

# Neon Auth — Auth page in the Neon console
NEON_AUTH_BASE_URL=
# openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Encrypts stored TMDB session ids. openssl rand -base64 32
ENCRYPTION_KEY=
# Derives the hidden credentials behind "Continue with TMDB".
# Treat as permanent: changing it orphans accounts created that way.
# openssl rand -base64 32
TMDB_BRIDGE_SECRET=

# Only needed when the public URL differs from the request origin (e.g. behind a proxy).
# NEXT_PUBLIC_APP_URL=http://localhost:3000
